{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Library that enables close-by players to communicate with each other autonomously.\\nOriginal Author: EnderKill98 | Port by: chicken_awa",
  "icon": "assets/proxlib/Icon_x128_pngquant.png",
  "authors": [ "EnderKill98, chicken_awa" ],
  "contact": {
    "homepage": "https://github.com/chicken-awa/ProxLib-Port",
    "sources": "https://github.com/chicken-awa/ProxLib-Port",
    "issues": "https://github.com/chicken-awa/ProxLib-Port/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [ "me.enderkill98.proxlib.client.ProxLib" ]
  },
  "custom": {
    "modmenu": { "badges": [ "library" ] }
  },
  "mixins": [ "proxlib.mixins.json" ],
  "depends": {
    "java": "${java}",
    "minecraft": "${mcdep}",
    "fabricloader": ">=0.14"
